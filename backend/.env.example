# ===== 模型 =====
# Kimi（M4 模块会用到联网检索）
REREAD_LLM_BASE_URL=https://api.moonshot.cn/v1
REREAD_LLM_API_KEY=your_kimi_api_key
REREAD_LLM_MODEL=kimi-k2.6
REREAD_LLM_TEMPERATURE=0.2

# 或使用豆包
# REREAD_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# REREAD_LLM_API_KEY=your_doubao_api_key
# REREAD_LLM_MODEL=doubao-seed-2.0-pro

# ===== 服务 =====
# 云托管会注入 PORT，本地默认 8787
REREAD_HOST=0.0.0.0
REREAD_PORT=8787

# ===== 存储 =====
# file：本地 JSON（仅开发调试）
# cloud：云开发数据库（云托管必填）
REREAD_STORE=file
REREAD_DATA_DIR=

# 云开发环境 id，REREAD_STORE=cloud 时必填
TCB_ENV=

# ===== 自用保护 =====
# 每日解析上限
REREAD_DAILY_LIMIT=20
# 只允许这些 openid 调用，逗号分隔；留空则不限制
REREAD_ALLOWED_OPENIDS=
# 填 1 则必须带微信身份（云托管会自动透传）
REREAD_REQUIRE_OPENID=0
